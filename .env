# Versions, resources and workload for every run. No secrets belong here.
# Override any value per run, for example: make bench JAVA_VERSION=25 LANGS=java

JAVA_VERSION=27
GO_VERSION=1.27
RUST_VERSION=1.99
NODE_VERSION=26
NGINX_VERSION=1.31
SPRING_JAVA_VERSION=25

# Same resources for every app, every scenario, on compose and on Kubernetes.
# JVM settings follow the Microsoft guide for Java in containers: 2 cores, ParallelGC, heap at 75% of the limit.
# HEAP_PERCENT also caps the native image heap. JVM_GC applies to the JVM only, native has the serial collector.
APP_CPUS=2
APP_MEMORY_MB=1536
HEAP_PERCENT=75
JVM_GC=ParallelGC
JAVA_OPTS=
LOADGEN_CPUS=2

ROUNDS=20
BATCH_BITS=2048
BATCH_COUNT=200

SERVER_BITS=512
USERS=1000
DURATION=60s
RAMP_UP=15s
THINK_TIME=2s

GATEWAY_LANGS=java go rust spring spring-native
GATEWAY_USERS=4000
GATEWAY_THINK_TIME=2s
MOCK_CPUS=1
MOCK_LATENCY=30ms
MOCK_JITTER=10ms
MOCK_TRANSACTIONS=40
MOCK_ERROR_RATE=0

# Versions, resources and workload for every run. No secrets belong here.
# Override any value per run, for example: make bench JAVA_VERSION=25 LANGS=java

JAVA_VERSION=27
GO_VERSION=1.27
RUST_VERSION=1.99
NODE_VERSION=26
NGINX_VERSION=1.31

APP_CPUS=4
APP_MEMORY=2g
LOADGEN_CPUS=2

ROUNDS=20
BATCH_BITS=2048
BATCH_COUNT=200

SERVER_BITS=512
USERS=2000
DURATION=60s
RAMP_UP=15s
THINK_TIME=2s
